# Copy this file to ".env" and fill in the values. Never commit ".env".

# Discord bot token (Developer Portal -> your app -> Bot -> Reset Token)
BOT_TOKEN=

# OpenAI API key, used by /customize (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional: model that designs your server. Defaults to gpt-4.1.
# Any chat model that supports structured outputs works.
# LUNA_MODEL=gpt-5-mini
