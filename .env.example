# Copy this file to ".env" and fill in the values. Never commit ".env".

# Discord bot token (Developer Portal -> your app -> Bot -> Reset Token)
BOT_TOKEN=

# Anthropic API key, used by /customize (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: model that designs your server. Defaults to claude-opus-5-5.
# LUNA_MODEL=claude-sonnet-5-5
